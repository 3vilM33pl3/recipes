# Server
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://localhost/recipes

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.2

# File storage paths
UPLOAD_DIR=./data/uploads
THUMBNAIL_DIR=./data/thumbnails
QRCODE_DIR=./data/qrcodes

# Limits
MAX_FILE_SIZE=20971520
ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/heic,image/heif,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/msword
